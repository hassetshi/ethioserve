<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug-build-only (never merged into release): trusts user-installed
         CA certificates in addition to the system store, needed to develop
         behind local TLS-intercepting software (antivirus/corporate proxy
         SSL scanning). See res/xml/network_security_config.xml in this same
         src/debug source set. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
