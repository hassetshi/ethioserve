# Root-level reference of every secret/config value used across the
# EthioServe project. Real values live in per-app, per-environment files
# that are gitignored (mobile/env/*.json, admin-web/.env.*, and whatever
# secret store CI/CD and Edge Functions are configured with) — never here.
#
# See LOCAL_DEVELOPMENT.md, STAGING.md, and PRODUCTION.md for how each of
# these is actually supplied per environment.

# --- Supabase (client-safe: anon/publishable key only) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Supabase (server-only: Edge Functions / admin-web backend, NEVER in the Flutter app) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- AI search ---
AI_API_URL=
AI_API_KEY=

# --- Maps / geocoding ---
MAPS_API_KEY=

# --- Payments (Stripe) ---
# Publishable key only — client-safe, compiled into the Flutter app.
STRIPE_PUBLISHABLE_KEY=
# Secret key and webhook signing secret are server-only: set via
# `supabase secrets set STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=...`,
# never in a client env file.

# --- Push notifications ---
FCM_SERVER_KEY=

# --- Environment marker ---
ENVIRONMENT=development
